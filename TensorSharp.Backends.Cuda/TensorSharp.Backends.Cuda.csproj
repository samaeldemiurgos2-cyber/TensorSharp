<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <IsPackable>true</IsPackable>
    <Nullable>disable</Nullable>
    <Description>Direct CUDA backend for TensorSharp using the CUDA Driver API, cuBLAS, PTX kernels, and quantized CUDA ops.</Description>
    <PackageTags>$(TensorSharpPackageTags);backend;cuda;cublas;gpu;ptx</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TensorSharp.Core\TensorSharp.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CudaKernelDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'native', 'kernels'))</CudaKernelDir>
    <!-- Committed PTX baseline, used when nvcc is unavailable. nvcc output goes to
         the intermediate directory below so that building never modifies files
         tracked in git (see discussion #130); refresh the committed baseline
         explicitly with `dotnet build -p:TensorSharpUpdateCommittedPtx=true`
         after editing a kernel, and commit the resulting diff. -->
    <CudaCommittedPtxDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'native', 'ptx'))</CudaCommittedPtxDir>
    <PtxOutputDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'obj', 'cuda_ptx', 'ptx'))</PtxOutputDir>
    <CudaPtxStampDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'obj', 'cuda_ptx'))</CudaPtxStampDir>
    <CudaArchResolverPs1>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'native', 'resolve-cuda-arch.ps1'))</CudaArchResolverPs1>
    <CudaArchResolverSh>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'native', 'resolve-cuda-arch.sh'))</CudaArchResolverSh>
    <CudaArch Condition="'$(CudaArch)' == '' And '$(TENSORSHARP_CUDA_ARCH)' != ''">$(TENSORSHARP_CUDA_ARCH)</CudaArch>
    <CudaArch Condition="'$(CudaArch)' == ''">auto</CudaArch>
    <!-- CudaArchFallback (the target when no GPU is detected) defaults by toolkit:
         compute_61 for CUDA 12, compute_75 for CUDA 13+, which dropped the
         pre-Turing targets. Set it to pin one. -->
    <!-- Besides PTX, nvcc builds a .fatbin per kernel file: SASS for the resolved
         architecture (or for every CudaFatbinArchitectures entry, e.g. "75,86,89,90,120")
         plus that PTX. A driver older than the toolkit can load the SASS - CUDA
         minor-version compatibility - but cannot JIT the toolkit's newer PTX. -->
    <CudaEmitFatbin Condition="'$(CudaEmitFatbin)' == ''">true</CudaEmitFatbin>
    <CudaNvccOptimizationFlags Condition="'$(CudaNvccOptimizationFlags)' == ''">-O3 --extra-device-vectorization</CudaNvccOptimizationFlags>
    <CudaEnableFastMath Condition="'$(CudaEnableFastMath)' == ''">false</CudaEnableFastMath>
    <CudaFastMathFlag Condition="'$(CudaEnableFastMath)' == 'true' Or '$(CudaEnableFastMath)' == 'True'">--use_fast_math</CudaFastMathFlag>
  </PropertyGroup>

  <ItemGroup>
    <CudaKernel Include="$(CudaKernelDir)/*.cu">
      <FastMathFlag></FastMathFlag>
    </CudaKernel>
    <!-- Headers the kernels #include (e.g. the vendored IQ2_XXS tables). Tracked as
         build inputs so editing them re-triggers the PTX compile below. -->
    <CudaKernelHeader Include="$(CudaKernelDir)/*.cuh" />
    <!-- The committed PTX baseline flows to this project's output, to referencing
         projects and to publish layouts as cuda_kernels/*.ptx. On machines with
         nvcc, SelectCudaPtxContent below swaps these for the locally compiled
         PTX before target paths are assigned. -->
    <Content Include="$(CudaCommittedPtxDir)/*.ptx" Link="cuda_kernels\%(Filename)%(Extension)" Condition="Exists('$(CudaCommittedPtxDir)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="DetectCudaPtxBuildSettings">
    <Exec Command="nvcc --version" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_NvccExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_NvccVersionText" />
    </Exec>
    <PropertyGroup>
      <_NvccMajor>$([System.Text.RegularExpressions.Regex]::Match('$(_NvccVersionText)', 'release (\d+)\.').Groups[1].Value)</_NvccMajor>
      <_CudaArchFallback Condition="'$(CudaArchFallback)' != ''">$(CudaArchFallback)</_CudaArchFallback>
      <_CudaArchFallback Condition="'$(_CudaArchFallback)' == '' And '$(_NvccMajor)' != '' And $(_NvccMajor) &gt;= 13">compute_75</_CudaArchFallback>
      <_CudaArchFallback Condition="'$(_CudaArchFallback)' == ''">compute_61</_CudaArchFallback>
    </PropertyGroup>
    <Exec Condition="'$(_NvccExitCode)' == '0' And '$(TensorSharpUpdateCommittedPtx)' != 'true' And ('$(CudaArch)' == 'auto' Or '$(CudaArch)' == 'native') And '$([MSBuild]::IsOSPlatform(Windows))' == 'true'"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(CudaArchResolverPs1)&quot; -FallbackArch &quot;$(_CudaArchFallback)&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DetectedCudaArch" />
      <Output TaskParameter="ExitCode" PropertyName="_DetectCudaArchExitCode" />
    </Exec>
    <Exec Condition="'$(_NvccExitCode)' == '0' And '$(TensorSharpUpdateCommittedPtx)' != 'true' And ('$(CudaArch)' == 'auto' Or '$(CudaArch)' == 'native') And '$([MSBuild]::IsOSPlatform(Windows))' != 'true'"
          Command="sh &quot;$(CudaArchResolverSh)&quot; &quot;$(_CudaArchFallback)&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DetectedCudaArch" />
      <Output TaskParameter="ExitCode" PropertyName="_DetectCudaArchExitCode" />
    </Exec>
  </Target>

  <!-- Keep architecture resolution independent of the installed toolchain so
       the portable-baseline policy can also be checked without nvcc or a GPU. -->
  <Target Name="ResolveCudaPtxArchitecture">
    <Error Condition="'$(TensorSharpUpdateCommittedPtx)' == 'true' And '$(CudaArch)' != 'auto' And '$(CudaArch)' != 'native' And '$(CudaArch)' != 'compute_61' And '$(CudaArch)' != 'sm_61'"
           Text="The committed CUDA PTX baseline must target compute_61 for machines without nvcc. Use -p:CudaArch=compute_61 (with a CUDA 12 toolkit; CUDA 13 starts at compute_75), or omit TensorSharpUpdateCommittedPtx for a GPU-specific local build. Requested target: $(CudaArch)." />
    <PropertyGroup>
      <_CudaArchFallback Condition="'$(_CudaArchFallback)' == ''">$(CudaArchFallback)</_CudaArchFallback>
      <_CudaArchFallback Condition="'$(_CudaArchFallback)' == ''">compute_61</_CudaArchFallback>
      <_ResolvedCudaArch Condition="'$(TensorSharpUpdateCommittedPtx)' == 'true'">compute_61</_ResolvedCudaArch>
      <_ResolvedCudaArch Condition="'$(TensorSharpUpdateCommittedPtx)' != 'true' And '$(CudaArch)' != 'auto' And '$(CudaArch)' != 'native'">$(CudaArch)</_ResolvedCudaArch>
      <_ResolvedCudaArch Condition="'$(_ResolvedCudaArch)' == '' And '$(_DetectCudaArchExitCode)' == '0' And '$(_DetectedCudaArch)' != ''">$(_DetectedCudaArch.Trim())</_ResolvedCudaArch>
      <_ResolvedCudaArch Condition="'$(_ResolvedCudaArch)' == ''">$(_CudaArchFallback)</_ResolvedCudaArch>
      <!-- The committed baseline is PTX only; GPU-specific builds also get a fatbin. -->
      <_CudaFatbinArch Condition="'$(TensorSharpUpdateCommittedPtx)' != 'true' And '$(CudaEmitFatbin)' == 'true'">$([System.Text.RegularExpressions.Regex]::Match('$(_ResolvedCudaArch)', '^(?:compute|sm)_(\d{2,3})$').Groups[1].Value)</_CudaFatbinArch>
      <_CudaFatbinSassArchs Condition="'$(_CudaFatbinArch)' != '' And '$(CudaFatbinArchitectures)' != ''">$(CudaFatbinArchitectures.Replace(',', ';').Replace(' ', ''))</_CudaFatbinSassArchs>
      <_CudaFatbinSassArchs Condition="'$(_CudaFatbinArch)' != '' And '$(_CudaFatbinSassArchs)' == ''">$(_CudaFatbinArch)</_CudaFatbinSassArchs>
    </PropertyGroup>
    <ItemGroup>
      <!-- The comma-to-semicolon Replace above leaves its ';' escaped. -->
      <_CudaFatbinSass Include="$([MSBuild]::Unescape($(_CudaFatbinSassArchs)))" />
    </ItemGroup>
    <PropertyGroup>
      <!-- Built from the PTX, so every SASS entry must be at or above its target
           (CI resolves to the compute_75 fallback on GPU-less runners). -->
      <!-- Blackwell RTX SASS is built for the architecture-specific target (sm_120a / sm_121a):
           it runs on every device of that family and enables the block-scaled FP4 tensor-core
           MMA the direct-CUDA Qwen3.5 engine uses (tensorsharp_q35_kernels.cu). -->
      <_CudaFatbinGencode Condition="'$(_CudaFatbinArch)' != ''">@(_CudaFatbinSass->'-gencode arch=compute_%(Identity),code=sm_%(Identity)', ' ') -gencode arch=compute_$(_CudaFatbinArch),code=compute_$(_CudaFatbinArch)</_CudaFatbinGencode>
      <_CudaFatbinGencode Condition="'$(_CudaFatbinGencode)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_CudaFatbinGencode)', 'arch=compute_(12[01]),code=sm_12[01]\b', 'arch=compute_$1a,code=sm_$1a'))</_CudaFatbinGencode>
      <_CudaBuildSettingsKey>$(_ResolvedCudaArch.Replace('compute_', 'compute_').Replace('sm_', 'sm_'))_$(CudaNvccOptimizationFlags.Replace(' ', '_').Replace('-', ''))$(CudaFastMathFlag.Replace(' ', '_').Replace('-', ''))</_CudaBuildSettingsKey>
      <_CudaFatbinOutputs Condition="'$(_CudaFatbinArch)' != ''">@(CudaKernel->'$(PtxOutputDir)/%(Filename).fatbin')</_CudaFatbinOutputs>
      <_CudaBuildSettingsKey Condition="'$(_CudaFatbinArch)' != ''">$(_CudaBuildSettingsKey)_fatbin$(_CudaFatbinSassArchs.Replace(';', '-'))</_CudaBuildSettingsKey>
    </PropertyGroup>
  </Target>

  <Target Name="ResolveCudaPtxBuildSettings" DependsOnTargets="DetectCudaPtxBuildSettings;ResolveCudaPtxArchitecture">
    <Error Condition="'$(TensorSharpUpdateCommittedPtx)' == 'true' And '$(_NvccExitCode)' != '0'"
           Text="Refreshing the committed CUDA PTX baseline requires nvcc on PATH and a toolkit that supports compute_61. Omit TensorSharpUpdateCommittedPtx to build with the existing committed kernels." />
    <Error Condition="'$(TensorSharpUpdateCommittedPtx)' == 'true' And '$(_NvccMajor)' != '' And $(_NvccMajor) &gt;= 13"
           Text="Refreshing the committed CUDA PTX baseline needs a CUDA 12 nvcc: the baseline targets compute_61, which CUDA $(_NvccMajor) no longer compiles. Put a CUDA 12 toolkit first on PATH for the refresh." />
    <!-- PTX files share one output directory across architecture settings.
         A prior compute_61 stamp cannot prove that later GPU-specific output
         is portable. Invalidate it for explicit baseline refreshes only. -->
    <Delete Condition="'$(TensorSharpUpdateCommittedPtx)' == 'true'"
            Files="$(CudaPtxStampDir)/tensorsharp_cuda_$(_CudaBuildSettingsKey).stamp" />
    <Message Condition="'$(_NvccExitCode)' == '0' And ('$(CudaArch)' == 'auto' Or '$(CudaArch)' == 'native') And '$(_DetectCudaArchExitCode)' != '' And '$(_DetectCudaArchExitCode)' != '0'"
             Importance="high"
             Text="WARNING: TensorSharp CUDA architecture detection failed; using $(_CudaArchFallback)." />
    <Message Condition="'$(_NvccExitCode)' == '0'" Importance="high" Text="TensorSharp CUDA build: PTX target is $(_ResolvedCudaArch)" />
    <Message Condition="'$(_NvccExitCode)' == '0' And '$(_CudaFatbinGencode)' != ''" Importance="high" Text="TensorSharp CUDA build: fatbin SASS for sm_$(_CudaFatbinSassArchs.Replace(';', ', sm_')) plus compute_$(_CudaFatbinArch) PTX" />
  </Target>

  <!-- When nvcc is available, replace the committed PTX Content items with the
       locally compiled ones from the intermediate directory, so this project's
       output, referencing projects and publish layouts all receive PTX that
       matches the local kernel sources and GPU. Hooked before AssignTargetPaths
       so the swapped items flow through GetCopyToOutputDirectoryItems to
       consumers; skipped for IDE design-time builds, which should not probe
       nvcc. CompileCudaPtx (BeforeTargets=BeforeBuild) has produced the files
       by the time anything copies them. -->
  <Target Name="SelectCudaPtxContent"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveCudaPtxBuildSettings"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup Condition="'$(_NvccExitCode)' == '0'">
      <Content Remove="$(CudaCommittedPtxDir)/*.ptx" />
      <Content Include="@(CudaKernel->'$(PtxOutputDir)/%(Filename).ptx')">
        <Link>cuda_kernels\%(Filename).ptx</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="@(CudaKernel->'$(PtxOutputDir)/%(Filename).fatbin')" Condition="'$(_CudaFatbinGencode)' != ''">
        <Link>cuda_kernels\%(Filename).fatbin</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="@(CudaKernel->'$(PtxOutputDir)/%(Filename).fatbin.sha256')" Condition="'$(_CudaFatbinGencode)' != ''">
        <Link>cuda_kernels\%(Filename).fatbin.sha256</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    <ItemGroup Condition="'$(_NvccExitCode)' != '0'">
      <!-- A previous GPU-specific build can be newer than the portable
           baseline. Replace it even when timestamps would preserve it. -->
      <Content Update="$(CudaCommittedPtxDir)/*.ptx">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <!-- The CUDA kernels are self-contained: the only data they needed from ggml
       (the IQ2_XXS dequant lookup tables) is vendored in
       native/kernels/tensorsharp_iq2xxs_tables.cuh, so this backend builds without
       the upstream ggml checkout (ExternalProjects/ggml) or any ggml fetch step. -->
  <Target Name="CompileCudaPtx"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="ResolveCudaPtxBuildSettings"
          Inputs="@(CudaKernel);@(CudaKernelHeader);$(MSBuildProjectFullPath);$(CudaArchResolverPs1);$(CudaArchResolverSh)"
          Outputs="@(CudaKernel->'$(PtxOutputDir)/%(Filename).ptx');$(_CudaFatbinOutputs);$(CudaPtxStampDir)/tensorsharp_cuda_$(_CudaBuildSettingsKey).stamp">
    <Message Condition="'$(_NvccExitCode)' != '0'" Importance="high"
             Text="TensorSharp CUDA build: nvcc not found; using the committed PTX kernels." />
    <PropertyGroup Condition="'$(_NvccExitCode)' == '0' And '$([MSBuild]::IsOSPlatform(Windows))' == 'true' And '$(VCToolsInstallDir)' != ''">
      <_CompilerBinDir>--compiler-bindir="$(VCToolsInstallDir)bin\Hostx64\x64"</_CompilerBinDir>
    </PropertyGroup>
    <!-- The query below asks vswhere for "all, including prerelease" rather than
         "latest": the VS installer flags an instance "incomplete" after an
         interrupted update, and a latest-only query silently skips such instances
         (prints nothing, exits 0) even though cl.exe on disk works fine. nvcc
         would then run with no host compiler directory and fail with
         "Cannot find compiler 'cl.exe' in PATH". Same reasoning as
         eng/vs-locate.ps1. -->
    <Exec Condition="'$(_NvccExitCode)' == '0' And '$([MSBuild]::IsOSPlatform(Windows))' == 'true' And '$(_CompilerBinDir)' == ''"
          Command="for /f &quot;delims=&quot; %%i in ('&quot;%25ProgramFiles(x86)%25\Microsoft Visual Studio\Installer\vswhere.exe&quot; -all -prerelease -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find VC\Tools\MSVC\**\bin\Hostx64\x64\cl.exe') do @echo %%~dpi"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ClExeDir" />
    </Exec>
    <PropertyGroup Condition="'$(_CompilerBinDir)' == '' And '$(_ClExeDir)' != ''">
      <!-- vswhere prints one line per installed MSVC toolset and Exec joins them
           with ';', which nvcc would reject as a single bogus compiler-bindir
           path. Keep only the first (oldest) toolset: nvcc caps the host cl
           version it accepts, so the oldest installed toolset is the safest. -->
      <_ClExeDirClean>$(_ClExeDir.Split(';')[0].Trim().TrimEnd('\'))</_ClExeDirClean>
      <_CompilerBinDir>--compiler-bindir=&quot;$(_ClExeDirClean)&quot;</_CompilerBinDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_NvccExitCode)' == '0' And '$(_CompilerBinDir)' != ''">
      <!-- MSVC 14.5x toolsets (VS 2026) are newer than the host-compiler range
           current CUDA toolkits accept, so nvcc aborts in host_config.h with
           "unsupported Microsoft Visual Studio version!". Let it proceed; the
           flag is a no-op once the installed CUDA toolkit officially supports
           the toolset. -->
      <_NvccAllowUnsupportedCompilerFlag Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_CompilerBinDir)', 'MSVC\\14\.[5-9][0-9]'))">-allow-unsupported-compiler</_NvccAllowUnsupportedCompilerFlag>
    </PropertyGroup>
    <MakeDir Condition="'$(_NvccExitCode)' == '0'" Directories="$(PtxOutputDir);$(CudaPtxStampDir)" />
    <Message Condition="'$(_NvccExitCode)' == '0'" Importance="high" Text="Compiling %(CudaKernel.Filename).cu to PTX for $(_ResolvedCudaArch)" />
    <Exec Condition="'$(_NvccExitCode)' == '0'"
          Command="nvcc -ptx -arch=$(_ResolvedCudaArch) $(CudaNvccOptimizationFlags) $(CudaFastMathFlag) %(CudaKernel.FastMathFlag) $(_CompilerBinDir) $(_NvccAllowUnsupportedCompilerFlag) -o &quot;$(PtxOutputDir)/%(CudaKernel.Filename).ptx&quot; &quot;%(CudaKernel.FullPath)&quot;"
          StandardOutputImportance="low" />
    <!-- The fatbin is compiled from the same source and flags as the PTX just written
         (from source, so architecture-specific targets get their own code paths), and its
         sidecar records that PTX's SHA-256: CudaModule loads a fatbin only beside the PTX
         of its own build, so one left behind by an earlier build is never preferred. -->
    <Exec Condition="'$(_NvccExitCode)' == '0' And '$(_CudaFatbinGencode)' != ''"
          Command="nvcc -fatbin $(_CudaFatbinGencode) $(CudaNvccOptimizationFlags) $(CudaFastMathFlag) %(CudaKernel.FastMathFlag) $(_CompilerBinDir) $(_NvccAllowUnsupportedCompilerFlag) -o &quot;$(PtxOutputDir)/%(CudaKernel.Filename).fatbin&quot; &quot;%(CudaKernel.FullPath)&quot;"
          StandardOutputImportance="low" />
    <GetFileHash Condition="'$(_NvccExitCode)' == '0' And '$(_CudaFatbinGencode)' != ''"
                 Files="@(CudaKernel->'$(PtxOutputDir)/%(Filename).ptx')" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_CompiledPtxHash" />
    </GetFileHash>
    <WriteLinesToFile Condition="'$(_NvccExitCode)' == '0' And '$(_CudaFatbinGencode)' != ''"
                      File="$(PtxOutputDir)/%(_CompiledPtxHash.Filename).fatbin.sha256"
                      Lines="%(_CompiledPtxHash.FileHash)"
                      Overwrite="true" />
    <WriteLinesToFile Condition="'$(_NvccExitCode)' == '0'"
                      File="$(CudaPtxStampDir)/tensorsharp_cuda_$(_CudaBuildSettingsKey).stamp"
                      Lines="arch=$(_ResolvedCudaArch);flags=$(CudaNvccOptimizationFlags) $(CudaFastMathFlag);fatbin=$(_CudaFatbinSassArchs)"
                      Overwrite="true" />
  </Target>

  <Target Name="CopyCudaPtxToOutput" AfterTargets="CompileCudaPtx" Condition="'$(_NvccExitCode)' == '0'">
    <ItemGroup>
      <_CompiledPtx Include="$(PtxOutputDir)/*.ptx" />
      <_CompiledPtx Include="$(PtxOutputDir)/*.fatbin;$(PtxOutputDir)/*.fatbin.sha256" Condition="'$(_CudaFatbinGencode)' != ''" />
    </ItemGroup>
    <MakeDir Directories="$([MSBuild]::NormalizePath('$(OutDir)', 'cuda_kernels'))" Condition="'@(_CompiledPtx)' != ''" />
    <Copy SourceFiles="@(_CompiledPtx)"
          DestinationFolder="$([MSBuild]::NormalizePath('$(OutDir)', 'cuda_kernels'))"
          SkipUnchangedFiles="true"
          Condition="'@(_CompiledPtx)' != ''" />
  </Target>

  <!-- Explicit opt-in that copies the freshly compiled PTX over the committed
       baseline in native/ptx:
         dotnet build TensorSharp.Backends.Cuda -p:TensorSharpUpdateCommittedPtx=true
       Run this after editing a .cu kernel and commit the resulting diff -
       machines without nvcc run the committed PTX, so a kernel change that is
       not regenerated here ships silently-stale kernels to them. The
       committed baseline targets compute_61 even on newer GPUs; auto/native
       resolve to that portable target only for this opt-in operation. -->
  <Target Name="UpdateCommittedCudaPtx"
          AfterTargets="CompileCudaPtx"
          Condition="'$(TensorSharpUpdateCommittedPtx)' == 'true' And '$(_NvccExitCode)' == '0'">
    <Error Condition="'$(_ResolvedCudaArch)' != 'compute_61'"
           Text="Refusing to overwrite the portable committed CUDA PTX baseline with target $(_ResolvedCudaArch). Rebuild with -p:CudaArch=compute_61." />
    <Copy SourceFiles="@(CudaKernel->'$(PtxOutputDir)/%(Filename).ptx')"
          DestinationFolder="$(CudaCommittedPtxDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Updated committed PTX baseline in $(CudaCommittedPtxDir) (arch $(_ResolvedCudaArch)); review and commit the diff." />
  </Target>
</Project>
