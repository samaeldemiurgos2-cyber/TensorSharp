{
  // Qwen-Image-2.1-Turbo: Qwen-Image-2.1 distilled to 8 Euler steps at CFG 1, for text-to-image
  // and editing. Same VAE, Qwen3-VL-8B text encoder and vision projector as Qwen-Image-2.1,
  // under the file names their publishers use; point a Qwen-Image-2.1 config at the same folder
  // and file names and the two models share one download of them.
  // Both CLI and Server.Host verify SHA-256 for new downloads; cached files are reused.
  //
  //   TensorSharp.Cli --config config/qwen-image-2.1-turbo.json --prompt "..." --width 1024 --height 1024
  //   TensorSharp.Server.Host --config config/qwen-image-2.1-turbo.json
  //
  // The GGUF names only its architecture (qwen_image), and Turbo has the base checkpoint's
  // tensors, so nothing in the file tells the two apart: this config declares the checkpoint
  // ("qwen-image-variant": "turbo"). Turbo then samples its published
  // schedule, the model_index.json sample_sigmas [1.0, 0.978453, 0.95418, 0.926626, 0.89508,
  // 0.845148, 0.704534, 0.414568] and a final 0, unshifted at every size, at CFG 1. Other step
  // counts are refused (Qwen has evaluated no other schedule), and so are step-distillation LoRA
  // plug-ins (they bring a second schedule). Defaults: native 2048x2048; edits retain the input
  // aspect ratio; explicit dimensions must be divisible by 32.
  //
  // The denoiser is Unsloth's Q5_K_S (4.50 GB), Dynamic 2.0 with an importance matrix collected on
  // Turbo at its own 8-step schedule. It is 0.3 GB larger than the card's recommended Q4_K_M, runs at
  // the same speed (7.97 vs 7.94 s/step at 1024x1024 on an M5 Pro) and stays closer to the F16
  // transformer (LPIPS against BF16 on the card: 0.103 vs 0.153; measured here, mean PSNR against the
  // F16 GGUF over four prompts: 22.4 vs 20.3 dB). Alternatives from the same revision:
  //   qwen-image-2.1-turbo-Q4_K_M.gguf  4.20 GB  sha256 8940e8b522af886e0c0f5afddf720e82dd223cb9a43580b5f61c4d740452ac20
  //   qwen-image-2.1-turbo-Q8_0.gguf    7.64 GB  sha256 399d2ddc3636f36456e2f5bfa57187da4e38721bc046430317f42a9eab5b1712
  // (Q8_0 is the transformer closest to full precision: LPIPS 0.036, 39.4 dB here, and 0.3 s/step
  // faster.) Replace the file name in "path" and "urls" and set "sha256". On macOS and Windows the
  // Q8_0 name matches AtomicChat's earlier Qwen-Image-2.1-Turbo-Q8_0.gguf except for letter case, and
  // a file already at "path" is reused without a hash check: delete an AtomicChat copy first.
  // Apple Silicon uses ggml_metal. Override --backend ggml_cuda for NVIDIA GPUs.
  // License: Qwen Research License (non-commercial); text encoder Apache-2.0.
  "variables": {
    "root": "${TENSORSHARP_MODELS:-../models}/qwen-image-2.1"
  },
  "backend": "ggml_metal",
  "qwen-image-variant": "turbo",
  "model": {
    "path": "${root}/qwen-image-2.1-turbo-Q5_K_S.gguf",
    "urls": ["https://huggingface.co/unsloth/Qwen-Image-2.1-Turbo-GGUF/resolve/5d1f9f759ea877ae556cda88dbec958b62ad3809/qwen-image-2.1-turbo-Q5_K_S.gguf"],
    "sha256": "72d93eb6f5d7be1a619c34f525393d001bc2fb9485d087f63c8462932b40177d"
  },
  "qwen-image-vae": {
    "path": "${root}/qwen_image_2.1_vae_bf16.safetensors",
    "urls": ["https://huggingface.co/Comfy-Org/Qwen-Image-2.1/resolve/ace0edeb3791a594ddfa36ed5f41a178a394e921/vae/qwen_image_2.1_vae_bf16.safetensors"],
    "sha256": "bb21f7473051e1ac368515dd3f2e15cd44d7a11748ee8823e1ddca3e4876b7c9"
  },
  "qwen-image-vl": {
    "path": "${root}/Qwen3VL-8B-Instruct-Q4_K_M.gguf",
    "urls": ["https://huggingface.co/Qwen/Qwen3-VL-8B-Instruct-GGUF/resolve/f982a07559d4a2f6c8744d840bf6fccab30eea96/Qwen3VL-8B-Instruct-Q4_K_M.gguf"],
    "sha256": "67d1659bfe71b89d50b45a4ad1a9e5b997e5bb16ce5da66a6a6167abd569e9e2"
  },
  "qwen-image-mmproj": {
    "path": "${root}/mmproj-Qwen3VL-8B-Instruct-F16.gguf",
    "urls": ["https://huggingface.co/Qwen/Qwen3-VL-8B-Instruct-GGUF/resolve/f982a07559d4a2f6c8744d840bf6fccab30eea96/mmproj-Qwen3VL-8B-Instruct-F16.gguf"],
    "sha256": "ca524100ebf825c9a870db1c580d03879e0da0ab2541697e2458e64891cf9d38"
  }
}
