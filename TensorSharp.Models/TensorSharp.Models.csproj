<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Desktop consumers build the single net10.0 target exactly as before. The TensorAgent
         app opts into its two Apple targets, net10.0-ios (iPhone and iPad) and
         net10.0-maccatalyst (the Mac app), with -p:TensorSharpAppleTargets=true. Those
         targets drop the packages with no Apple app binaries (Magick.NET, OpenCvSharp) and
         the Media/Desktop sources that use them in favour of the ImageIO/AVFoundation
         provider in Media/Apple, and land in bin/<tfm>/ so the net10.0 output path stays
         untouched. -->
    <TargetFramework Condition="'$(TensorSharpAppleTargets)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(TensorSharpAppleTargets)' == 'true'">net10.0;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Appending the TFM for the Apple targets gives each its own bin\<tfm>\ and
         obj\...\<tfm>\ intermediate directory; without it the targets would overwrite
         each other's compile outputs. -->
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFramework)' == 'net10.0-ios' Or '$(TargetFramework)' == 'net10.0-maccatalyst'">true</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios' Or '$(TargetFramework)' == 'net10.0-maccatalyst'">17.0</SupportedOSPlatformVersion>
    <IsPackable>true</IsPackable>
    <Nullable>annotations</Nullable>
    <Description>Model architecture implementations, multimodal encoders, and model execution helpers for TensorSharp.</Description>
    <PackageTags>$(TensorSharpPackageTags);models;multimodal;architecture</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InferenceWeb.Tests" />
    <InternalsVisibleTo Include="QwenImage21CompanionProbe" />
    <InternalsVisibleTo Include="CpuQuantBench" />
    <InternalsVisibleTo Include="WanVideoBench" />
    <InternalsVisibleTo Include="CpuFloatBench" />
    <InternalsVisibleTo Include="QwenImageDiTBench" />
    <InternalsVisibleTo Include="QwenImageStagesBench" />
    <InternalsVisibleTo Include="QwenImageMaskBench" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TensorSharp.Core\TensorSharp.Core.csproj" />
    <ProjectReference Include="..\TensorSharp.Runtime\TensorSharp.Runtime.csproj" />
    <ProjectReference Include="..\TensorSharp.Backends.GGML\TensorSharp.Backends.GGML.csproj" />
    <ProjectReference Include="..\TensorSharp.Backends.Cuda\TensorSharp.Backends.Cuda.csproj" />
    <ProjectReference Include="..\TensorSharp.Backends.MLX\TensorSharp.Backends.MLX.csproj" />
  </ItemGroup>
  <!-- Pure managed packages: the same on every target. -->
  <ItemGroup>
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="PdfPig" Version="0.1.8" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.7" />
  </ItemGroup>
  <!-- Native media libraries: no ios-arm64 or Mac Catalyst binaries exist for any of them,
       and both are dynamic libraries an iOS app could not link anyway. Only Media/Desktop/
       uses them (MediaLayeringTests enforces this), and that folder is removed from the
       Apple targets below rather than #if'd, so a stray native using in shared code fails
       the Apple compile loudly instead of throwing DllNotFoundException in the app. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'ios' And '$(TargetPlatformIdentifier)' != 'maccatalyst'">
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="OneWare.OpenCvSharp4.runtime.ubuntu.24.04-x64" Version="4.13.0.18" />
    <PackageReference Include="OneWare.OpenCvSharp4.runtime.ubuntu.24.04-arm64" Version="4.13.0.18" />
    <PackageReference Include="OneWare.OpenCvSharp4.runtime.osx-arm64" Version="4.13.0.18" />
    <PackageReference Include="OneWare.OpenCvSharp4.runtime.osx-x64" Version="4.13.0.18" />
    <PackageReference Include="OneWare.OpenCvSharp4.runtime.win-x64" Version="4.13.0.18" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260330" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst'">
    <Compile Remove="Media/Desktop/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'">
    <!-- Process-only libx264 transform; no OpenCV/Magick dependencies. iOS cannot
         spawn this tool and must keep temporal image conditioning unavailable. -->
    <Compile Include="Media/Desktop/FfmpegImageConditioning.cs" />
  </ItemGroup>
  <Import Project="../TensorSharp.Cpu.Native/Packaging.targets" />
</Project>
